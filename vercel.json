{
  "redirects": [
    { "source": "/blog/ppc-ads-kitchen-remodeling-contractors", "destination": "/blog/google-ads-kitchen-remodeling-contractors", "statusCode": 308 },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.growthliftstudio.in" }], "destination": "https://growthliftstudio.in/:path*", "statusCode": 308 }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
